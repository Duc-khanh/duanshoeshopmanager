<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8"/>
    <title>Chi tiết đơn hàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
</head>
<body class="bg-gray-50 min-h-screen flex justify-center p-6">
<!--<body class="bg-gray-50 min-h-screen flex flex-col">-->
<div th:replace="/admin/layout :: header"></div>
<div th:replace="/admin/layout :: sidebar"></div>

<div class="w-full max-w-4xl bg-white rounded-lg shadow-lg p-8 my-[10px] mt-[4rem] ml-72 mb-[48px]">

    <h2 class="text-2xl font-bold mb-6 border-b pb-3 text-gray-800">Chi tiết đơn hàng</h2>

    <div class="mb-6 space-y-2 text-gray-700">
        <p><strong class="font-semibold">Khách hàng:</strong> <span th:text="${order.user.username}">Nguyễn Văn A</span></p>
<!--        <p><strong class="font-semibold">Ngày đặt:</strong> <span th:text="${#dates.format(order.orderDate, 'dd/MM/yyyy HH:mm')}">01/01/2024 10:00</span></p>-->
        <p><strong class="font-semibold">Trạng thái:</strong> <span th:text="${order.status}">PENDING</span></p>
    </div>

    <form method="post" th:action="@{/update-status}" class="mb-8 flex items-center space-x-3">
        <input type="hidden" name="orderId" th:value="${order.orderID}" />
        <select name="status" class="border border-gray-300 rounded p-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="PENDING" th:selected="${order.status == 'PENDING'}">PENDING</option>
            <option value="CONFIRMED" th:selected="${order.status == 'CONFIRMED'}">CONFIRMED</option>
            <option value="SHIPPED" th:selected="${order.status == 'SHIPPED'}">SHIPPED</option>
            <option value="CANCELLED" th:selected="${order.status == 'CANCELLED'}">CANCELLED</option>
        </select>
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition">Cập nhật</button>
    </form>

    <h3 class="text-xl font-semibold mb-4 text-gray-800">Sản phẩm:</h3>
    <div class="overflow-x-auto" th:with="total=0">
        <table class="w-full border border-gray-300 rounded-md">
            <thead class="bg-gray-100 text-gray-700 font-semibold">
            <tr>
                <th class="border border-gray-300 px-4 py-2 text-left">Tên SP</th>
                <th class="border border-gray-300 px-4 py-2 text-center">SL</th>
                <th class="border border-gray-300 px-4 py-2 text-right">Giá</th>
                <th class="border border-gray-300 px-4 py-2 text-right">Tổng</th>
            </tr>
            </thead>
            <tbody>
            <tr th:each="detail, stat : ${order.orderDetails}"
                th:with="itemTotal=${detail.price * detail.quantity}"
                class="hover:bg-blue-50 transition-colors">
                <td class="border border-gray-300 px-4 py-2" th:text="${detail.product.productName}">Sản phẩm A</td>
                <td class="border border-gray-300 px-4 py-2 text-center" th:text="${detail.quantity}">1</td>
                <td class="border border-gray-300 px-4 py-2 text-right"
                    th:text="${#numbers.formatDecimal(detail.price, 0, 'COMMA', 3, 'POINT')} + ' đ'">100,000 đ</td>
                <td class="border border-gray-300 px-4 py-2 text-right"
                    th:text="${#numbers.formatDecimal(itemTotal, 0, 'COMMA', 3, 'POINT')} + ' đ'">100,000 đ</td>
            </tr>
            </tbody>
            <tfoot>
            <tr class="bg-gray-100 font-semibold text-gray-800">
                <td colspan="3" class="border border-gray-300 px-4 py-2 text-right">Tổng cộng:</td>
                <td class="border border-gray-300 px-4 py-2 text-right"
                    th:text="${#numbers.formatDecimal(totalAmount, 0, 'COMMA', 3, 'POINT')} + ' đ'">300,000 đ</td>
                </td>
            </tr>
            </tfoot>
        </table>
    </div>

</div>
<div th:replace="/admin/layout :: footer"></div>
</body>
</html>