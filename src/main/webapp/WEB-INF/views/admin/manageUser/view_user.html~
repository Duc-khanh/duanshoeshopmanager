<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <title>Chi Tiết Người Dùng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
<div th:replace="/admin/layout :: sidebar"></div>
<div th:replace="/admin/layout :: header"></div>
<main class="flex-grow flex justify-center items-center p-4 sm:p-6 md:p-10 min-h-screen ml-80">
    <div class="w-full max-w-md bg-white rounded-lg shadow-lg p-8">
        <h2 class="text-3xl font-semibold text-gray-800 mb-8 text-center">
            Chi Tiết Người Dùng
        </h2>
        <div class="space-y-6">
            <div>
                <p class="text-gray-700 font-medium mb-1">
                    Tên đăng nhập:
                </p>
                <p class="text-xl font-semibold text-gray-900" th:text="${user.username}">
                    Tên đăng nhập
                </p>
            </div>
            <div>
                <p class="text-gray-700 font-medium mb-1">
                    Email:
                </p>
                <p class="text-gray-800" th:text="${user.email != null ? user.email : 'Chưa cập nhật'}">
                    email@example.com
                </p>
            </div>
            <div>
                <p class="text-gray-700 font-medium mb-1">
                    Vai trò:
                </p>
                <p class="text-gray-800" th:text="${user.role != null ? user.role.roleName : 'Chưa phân quyền'}">
                    User
                </p>
            </div>
            <div class="flex justify-center mt-8">
                <a class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-semibold transition" href="/admin/user">
                    <i class="fas fa-arrow-left">
                    </i>
                    Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</main>
<div th:replace="/admin/layout :: footer"></div>
<script src="/js/fragment.js"></script>


</body>
</html>
