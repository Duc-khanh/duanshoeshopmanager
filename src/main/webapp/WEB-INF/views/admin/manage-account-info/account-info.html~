<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <title>
        Thông Tin Tài Khoản
    </title>
    <script src="https://cdn.tailwindcss.com">
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Roboto&amp;display=swap" rel="stylesheet"/>
</head>
<body class="bg-gray-50 font-['Roboto'] min-h-screen flex flex-col">
<div th:replace="/admin/layout :: sidebar"></div>
<div th:replace="/admin/layout :: header"></div>
<main class="flex-grow flex justify-center items-center px-4 py-12">
    <section class="bg-white rounded-lg shadow-lg p-8 flex flex-col items-center w-full max-w-3xl">
        <h1 class="text-3xl font-extrabold text-gray-900 mb-8 text-center">
            Thông Tin Tài Khoản
        </h1>

        <img alt="Ảnh đại diện người dùng" class="w-36 h-36 rounded-full object-cover border-4 border-indigo-500 shadow-md mb-8"
             th:src="@{${user.image}}" />

        <div class="w-full max-w-md">
            <div class="grid grid-cols-1 gap-6">
                <div>
                    <label class="block text-gray-600 font-semibold mb-1" for="username">Tên đăng nhập</label>
                    <p class="text-gray-800 text-lg" id="username" th:text="${user.username}"></p>
                </div>
                <div>
                    <label class="block text-gray-600 font-semibold mb-1" for="email">Email</label>
                    <p class="text-gray-800 text-lg break-words" id="email" th:text="${user.email}"></p>
                </div>
                <div>
                    <label class="block text-gray-600 font-semibold mb-1" for="address">Địa chỉ</label>
                    <p class="text-gray-800 text-lg" id="address" th:text="${user.address}"></p>
                </div>
            </div>

            <div class="mt-8 text-center">
                <a class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-lg shadow-md transition"
                   href="/admin/account/edit">
                    <i class="fas fa-edit mr-2"></i>Sửa thông tin
                </a>
            </div>
        </div>
    </section>
</main>
<div th:replace="/admin/layout :: footer"></div>

<script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
    });
</script>
</body>
</html>