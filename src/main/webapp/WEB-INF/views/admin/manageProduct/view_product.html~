<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <title>Chi Tiết Sản Phẩm</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
<div class="flex flex-col md:flex-row min-h-screen overflow-hidden">

    <div th:replace="/admin/layout :: sidebar"></div>

    <div class="flex-1 flex flex-col overflow-auto p-6">

        <div class="flex justify-center items-center flex-1 p-6 mt-16 mb-16 ml-72">
            <div class="bg-white shadow-xl rounded-xl w-full max-w-xl p-6 mx-auto">
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 mb-6 text-center">Chi Tiết Sản Phẩm</h2>

                <div class="flex flex-col space-y-6">
                    <div class="flex justify-center">
                        <img th:src="@{${product.image}}"
                             alt="Ảnh sản phẩm"
                             class="w-40 h-40 object-cover rounded-full border-4 border-gray-200 shadow-md" />
                    </div>

                    <div class="space-y-3 text-sm md:text-base">
                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Tên sản phẩm:</span>
                            <span class="font-semibold text-gray-800" th:text="${product.productName}">Tên sản phẩm</span>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Mô tả:</span>
                            <span class="whitespace-pre-line" th:text="${product.description}">Mô tả sản phẩm...</span>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Giá gốc:</span>
                            <span class="text-green-600 font-semibold"
                                  th:text="${#numbers.formatDecimal(product.price/1000, 0, 'COMMA', 3, 'POINT')} + ' đ'">₫0</span>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Giảm giá:</span>
                            <span class="text-yellow-600 font-semibold"
                                  th:text="${product.discountPercent != null ? product.discountPercent + '%' : '0%'}">0%</span>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Giá sau giảm:</span>
                            <span class="text-red-600 font-bold"
                                  th:text="${#numbers.formatDecimal(product.price * (1 - (product.discountPercent ?: 0) / 100.0) / 1000, 0, 'COMMA', 3, 'POINT')} + ' đ'">₫0</span>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Số lượng còn lại:</span>
                            <span th:text="${product.stock}">0</span>
                        </p>

                        <p class="text-gray-700">
                            <span class="font-medium text-gray-500">Danh mục:</span>
                            <span th:text="${product.category.categoryName}">Tên danh mục</span>
                        </p>
                    </div>

                    <!-- Nút quay lại -->
                    <div class="text-center mt-4">
                        <a class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold"
                           th:href="@{/admin/products}">
                            <i class="fas fa-arrow-left mr-2"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div th:replace="/admin/layout :: footer"></div>

<script src="/js/fragment.js"></script>
<script th:inline="javascript">
    function confirmLogout() {
        Swal.fire({
            title: 'Bạn có chắc chắn muốn đăng xuất?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Có',
            cancelButtonText: 'Không',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/logout";
            }
        });
    }
</script>
</body>
</html>
