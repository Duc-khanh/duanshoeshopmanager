<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Sửa sản phẩm</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap"
            rel="stylesheet"
    />
    <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"
    />
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen">
<div class="flex min-h-screen overflow-hidden">
    <div th:replace="/admin/layout :: sidebar"></div>

    <div class="flex-1 flex flex-col overflow-auto p-6">


        <div class="flex justify-center items-center flex-1 p-6 mt-10 ml-72">
            <form
                    th:action="@{/managerProduct/products/save}"
                    th:object="${product}"
                    method="post"
                    enctype="multipart/form-data"
                    class="bg-white shadow-lg rounded-lg w-full max-w-2xl p-8"
            >
                <h2 class="text-2xl font-semibold text-gray-800 mb-6 text-center">
                    Cập Nhật Thông Tin Sản Phẩm
                </h2>
                <input type="hidden" th:field="*{productID}">

                <label for="productName" class="block text-gray-700 font-medium mb-1">Tên sản phẩm:</label>
                <input type="text" id="productName" th:field="*{productName}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"/>

                <label for="description" class="block text-gray-700 font-medium mt-4 mb-1">Mô tả:</label>
                <textarea id="description" th:field="*{description}" rows="4" required
                          class="w-full px-4 py-2 border border-gray-300 rounded-md resize-none focus:ring-2 focus:ring-blue-500"></textarea>

                <label for="price" class="block text-gray-700 font-medium mt-4 mb-1">Giá:</label>
                <input type="number" id="price" th:field="*{price}" step="0.01" min="0" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"/>

                <label for="stock" class="block text-gray-700 font-medium mt-4 mb-1">Số lượng:</label>
                <input type="number" id="stock" min="0"  th:field="*{stock}" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"/>

                <label for="category" class="block text-gray-700 font-medium mt-4 mb-1">Danh mục:</label>
                <select id="category" th:field="*{category.categoryID}"
                        class="w-full px-4 py-2 border border-gray-300 rounded-md bg-white focus:ring-2 focus:ring-blue-500">
                    <option value="">--Chọn danh mục--</option>
                    <th:block th:each="cat : ${categories}">
                        <option th:value="${cat.categoryID}" th:text="${cat.categoryName}"></option>
                    </th:block>
                </select>

                <label for="image" class="block text-gray-700 font-medium mt-4 mb-1">Ảnh sản phẩm:</label>
                <input type="file" id="image" name="imageFile" accept="image/*"
                       class="w-full text-gray-700" onchange="previewImage(event)"/>
                <div class="mt-4 flex justify-center">
                    <input type="hidden" name="oldImagePath" th:value="${product.image}"/>
                    <img th:src="@{${product.image}}" id="imagePreview"
                         alt="Preview ảnh sản phẩm"
                         class="max-h-48 rounded-md border border-gray-300"
                         th:classappend="${product.image} == null ? 'hidden' : ''"/>
                </div>

                <button type="submit"
                        class="mt-6 w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-md transition-colors duration-300">
                    Cập nhật sản phẩm
                </button>
            </form>
        </div>
    </div>
</div>
<div th:replace="/admin/layout :: footer"></div>

<script>
    function previewImage(event){
        const input = event.target;
        const preview = document.getElementById('imagePreview');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove('hidden');
            };
            reader.readAsDataURL(input.files[0]);
        } else {
            preview.src = '';
            preview.classList.add('hidden');
        }
    }
</script>
</body>
<script src="/js/fragment.js"></script>

</html>