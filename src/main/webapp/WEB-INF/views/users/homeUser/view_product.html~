<html lang="vi">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Chi tiết sản phẩm</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

<div th:replace="/users/layout :: header"></div>

<main class="flex-grow container mx-auto px-4 py-10 max-w-5xl">
    <div class="bg-white rounded-2xl shadow-xl p-6 md:p-12 flex flex-col md:flex-row gap-8 md:gap-12">
        <div class="md:w-1/2 flex justify-center items-center p-4 md:p-8 relative">
            <img alt="Hình ảnh sản phẩm chi tiết, rõ nét, màu sắc trung thực, kích thước vừa phải, nền trắng"
                 class="object-contain max-h-[400px] w-full max-w-[420px] rounded-lg shadow-md"
                 th:src="${product.image}" >

        </div>

        <div class="md:w-1/2 mt-6 md:mt-0 flex flex-col justify-center px-2 md:px-0 text-gray-900">
            <h2 class="font-extrabold text-2xl leading-tight mb-3" th:text="${product.productName}">Tên sản phẩm</h2>
            <div class="w-16 h-1 bg-[#f15a29] rounded mb-5"></div>
            <div class="mb-4 flex items-center gap-4">
                <span class="text-[#f15a29] font-extrabold text-2xl tracking-wide"
                      th:text="${#numbers.formatDecimal(product.discountedPrice / 1000, 0, 'COMMA', 3, 'POINT')} + ' đ'">0 đ</span>
                <span th:if="${product.discountPercent > 0}"
                      class="line-through text-gray-400 text-lg"
                      th:text="${#numbers.formatDecimal(product.price / 1000, 0, 'COMMA', 3, 'POINT')} + ' đ'">0 đ</span>
<!--                <span th:if="${product.discountPercent > 0}"-->
<!--                      class="bg-[#f15a29] text-white text-xs font-semibold rounded-full px-2 py-0.5 select-none"-->
<!--                      th:text="'-' + product.discountPercent + '%'">-0%</span>-->
            </div>
            <p class="text-base font-medium mb-3 leading-relaxed" th:text="${product.description}">Mô tả chi tiết sản phẩm.</p>
            <p class="text-sm font-semibold text-[#f15a29] mb-6">Miễn phí đổi size | đổi mẫu trong 1 tuần !!!</p>
            <div class="mb-6">
                <label class="text-xs font-semibold uppercase tracking-wide text-gray-700 mb-2 block">SIZE</label>
                <div class="flex flex-wrap gap-3 max-w-md">
                    <!-- Nếu DB chưa có size thì hiển thị size mặc định -->
                    <button type="button" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">39</button>
                    <button type="button" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">40</button>
                    <button type="button" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">41</button>
                    <button type="button" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">42</button>
                    <button type="button" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">43</button>
                    <button type="button" class="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 transition">44</button>
                </div>
            </div>
            <form th:action="@{/cart/add/{productID}(productID=${product.productID})}" method="post"
                  class="flex flex-wrap items-center gap-3 max-w-md mb-6">
                <div class="flex items-center border border-gray-300 rounded-lg overflow-hidden">
                    <button type="button" onclick="decreaseQuantity()"
                            class="px-4 py-2 text-lg font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition select-none">-</button>
                    <input id="quantity" name="quantity" type="number" aria-label="Quantity" min="1" value="1"
                           class="w-16 text-center border-l border-r border-gray-300 py-2 text-sm focus:outline-none"/>
                    <input type="hidden" id="maxStock" th:value="${product.stock}"/>
                    <button type="button" onclick="increaseQuantity()"
                            class="px-4 py-2 text-lg font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 transition select-none">+</button>
                </div>
                <button type="submit"
                        class="bg-[#2563eb] text-white font-bold text-sm uppercase px-6 py-3 rounded-lg hover:bg-[#1e40af] transition flex-shrink-0 shadow-md"
                        title="Thêm vào giỏ hàng" aria-label="Thêm sản phẩm vào giỏ hàng">
                    Thêm vào giỏ hàng
                </button>
            </form>
            <form th:action="@{/checkout/buy-now/{productID}(productID=${product.productID})}" method="post" onsubmit="updateBuyNowQuantity()" class="max-w-md">
                <input type="hidden" name="quantity" id="buyNowQuantity" th:value="1"/>
                <button type="submit"
                        class="w-full bg-[#ff5722] text-white font-bold text-sm uppercase px-6 py-3 rounded-lg hover:bg-[#e64a19] transition shadow-md"
                        title="Mua ngay" aria-label="Mua ngay sản phẩm này">
                    Mua ngay
                </button>
            </form>
        </div>
    </div>
</main>
<div th:replace="/users/layout :: footer"></div>

</body>
<script src="/js/logout-handler.js"></script>
<script th:inline="javascript">
    function increaseQuantity() {
        const input = document.getElementById('quantity');
        const max = /*[[${product.stock}]]*/ 10;
        if (parseInt(input.value) < max) {
            input.value = parseInt(input.value) + 1;
            updateBuyNowQuantity();
        } else {
            alert("Không thể thêm quá " + max + " sản phẩm còn trong kho.");
        }
    }

    function decreaseQuantity() {
        const input = document.getElementById('quantity');
        if (parseInt(input.value) > 1) {
            input.value = parseInt(input.value) - 1;
            updateBuyNowQuantity();
        }
    }

    function updateBuyNowQuantity() {
        const buyNowInput = document.getElementById('buyNowQuantity');
        const quantityInput = document.getElementById('quantity');
        buyNowInput.value = quantityInput.value;
    }

    document.getElementById('quantity').addEventListener('input', updateBuyNowQuantity);
    document.getElementById('quantity').addEventListener('change', updateBuyNowQuantity);

    let addToCartSuccess = /*[[${addToCartSuccess}]]*/ false;

    if (addToCartSuccess) {
        Swal.fire({
            icon: 'success',
            title: 'Thành công!',
            text: 'Sản phẩm đã được thêm vào giỏ hàng.',
            confirmButtonColor: '#2563eb',
            confirmButtonText: 'OK'
        });
    }
</script>



</html>