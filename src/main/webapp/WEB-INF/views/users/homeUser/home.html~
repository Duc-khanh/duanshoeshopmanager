<!-- Product section -->
<main class="max-w-[110rem] mx-auto px-4 py-12 flex-grow">
    <h2 class="text-4xl font-extrabold text-gray-900 mb-12 text-center tracking-tight">
        Sản Phẩm Của Cửa Hàng
    </h2>

    <div
            class="max-w-7xl mx-auto mt-6 px-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 pb-10"
    >
        <div
                th:each="product : ${productList}"
                th:if="${product.stock > 0}"
                class="border border-white p-4 flex flex-col"
        >
            <div class="relative w-full h-44 rounded overflow-hidden bg-gray-50 flex items-center justify-center p-2">
                <img
                        th:src="${product.image}"
                        th:alt="'Hình ảnh sản phẩm ' + ${product.productName}"
                        class="object-contain max-h-full max-w-full hover:scale-105 transition-transform duration-300 ease-in-out"
                        width="180"
                        height="180"
                />
            </div>
            <p
                    class="text-center text-xs mt-2 flex-grow"
                    th:text="${product.productName}"
            >
                Tên sản phẩm
            </p>
            <div class="flex justify-center mt-1 text-yellow-500 text-xs space-x-0.5">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
            </div>
            <p
                    class="text-center text-xs font-semibold text-orange-600 mt-1"
                    th:text="${#numbers.formatDecimal(product.price, 0, 'COMMA', 3, 'POINT')} + ' đ'"
            >
                0 đ
            </p>
            <div class="flex justify-center gap-6 mt-auto">
                <a th:href="@{/cart/add/{productID}(productID=${product.productID})}"
                   class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-xl shadow-lg font-semibold flex items-center justify-center space-x-2 transition-colors duration-300">
                    <i class="fas fa-shopping-cart text-lg"></i>
                    <span>Đặt hàng</span>
                </a>
                <a th:href="@{/managerUser/view/{productID}(productID=${product.productID})}"
                   class="bg-blue-100 hover:bg-blue-200 text-blue-700 px-6 py-3 rounded-xl shadow-lg font-semibold flex items-center justify-center space-x-2 transition-colors duration-300">
                    <i class="fas fa-eye text-lg"></i>
                    <span>Chi tiết</span>
                </a>
            </div>
        </div>

    </div>

