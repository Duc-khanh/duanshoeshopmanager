<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Sản Phẩm Nổi Bật</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<!--<body class="bg-gray-50 min-h-screen flex flex-col">-->
<body class="bg-gradient-to-b from-blue-50 to-white min-h-screen flex flex-col">

<div th:replace="/users/layout :: header"></div>

<section class="max-w-[110rem] mx-auto px-4 mt-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">

        <div class="md:col-span-7 rounded-lg overflow-hidden shadow-lg group">
            <img    
                    src="https://sneaker.giaodienwebmau.com/wp-content/uploads/2022/04/giay-nike.jpg.webp"
                    alt="Large sneaker image"
                    class="w-full h-auto object-cover transform transition duration-500 group-hover:scale-105"
                    loading="lazy"
            />
        </div>


        <div class="md:col-span-5 flex flex-col gap-6">
            <div class="rounded-lg overflow-hidden shadow-lg group">
                <img
                        src="https://sneaker.giaodienwebmau.com/wp-content/uploads/2022/04/giay-jordan.jpg.webp"
                        alt="Top right sneaker image"
                        class="w-full h-auto object-cover transform transition duration-500 group-hover:scale-105"
                        loading="lazy"
                />
            </div>
            <div class="rounded-lg overflow-hidden shadow-lg group">
                <img
                        src="https://sneaker.giaodienwebmau.com/wp-content/uploads/2022/04/giay-mlb.jpg.webp"
                        alt="Bottom right sneaker image"
                        class="w-full h-auto object-cover transform transition duration-500 group-hover:scale-105"
                        loading="lazy"
                />
            </div>
        </div>
    </div>
</section>

<main class="max-w-[110rem] mx-auto px-4 py-12 flex-grow">
    <h2 class="text-4xl font-extrabold text-gray-900 mb-12 text-center tracking-tight">
        Sản Phẩm Nổi Bật
    </h2>

    <div
            th:if="${featuredProducts != null and #lists.isEmpty(featuredProducts) == false}"
            class="max-w-7xl mx-auto mt-6 px-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 pb-10"
    >
        <div
                th:each="product : ${featuredProducts}"
                th:if="${product.stock > 0}"
                class="border border-gray-300 p-4 flex flex-col group rounded-lg shadow-sm"
        >
            <a th:href="@{/managerUser/view/{productID}(productID=${product.productID})}" class="relative w-full h-44 rounded overflow-hidden bg-gray-100 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                <img
                        th:src="${product.image}"
                        th:alt="'Hình ảnh sản phẩm ' + ${product.productName}"
                        class="object-contain max-h-full max-w-full transition-transform duration-300 ease-in-out group-hover:scale-105"
                        width="180"
                        height="180"
                        loading="lazy"
                />
            </a>
            <p
                    class="text-center text-xs mt-2 flex-grow"
                    th:text="${product.productName}"
            >
                Tên sản phẩm
            </p>
            <div class="flex justify-center mt-1 text-yellow-500 text-xs space-x-0.5">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
            </div>
            <p class="text-center text-xs font-semibold text-orange-600 mt-1"
               th:text="${#numbers.formatDecimal(product.price / 1000, 0, 'COMMA', 3, 'POINT')} + ' đ'">
                0 đ
            </p>

            <div class="flex justify-center gap-6 mt-auto">

            </div>
        </div>
    </div>

    <div th:if="${featuredProducts == null or #lists.isEmpty(featuredProducts)}" class="max-w-7xl mx-auto mt-6 px-4 pb-10">
        <p class="text-center text-gray-500 text-lg font-semibold select-none">Không tìm thấy sản phẩm phù hợp.</p>
    </div>

    <h2 class="text-4xl font-extrabold text-gray-900 mb-12 mt-20 text-center tracking-tight">
        Sản Phẩm Khuyến Mãi Giảm Giá
    </h2>

    <div
            th:if="${discountedProducts != null and #lists.isEmpty(discountedProducts) == false}"
            class="max-w-7xl mx-auto mt-6 px-4 grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6 pb-10"
    >
        <div
                th:each="product : ${discountedProducts}"
                th:if="${product.stock > 0}"
                class="border border-gray-300 p-4 flex flex-col group rounded-lg shadow-sm"
        >
            <a th:href="@{/managerUser/view/{productID}(productID=${product.productID})}" class="relative w-full h-44 rounded overflow-hidden bg-gray-100 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                <img
                        th:src="${product.image}"
                        th:alt="'Hình ảnh sản phẩm ' + ${product.productName}"
                        class="object-contain max-h-full max-w-full transition-transform duration-300 ease-in-out group-hover:scale-105"
                        width="180"
                        height="180"
                        loading="lazy"
                />
            </a>
            <p class="text-center text-xs mt-2 flex-grow" th:text="${product.productName}">Tên sản phẩm</p>
            <div class="flex justify-center mt-1 text-yellow-500 text-xs space-x-0.5">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
            </div>
            <p class="text-center text-xs font-semibold text-orange-600 mt-1"
               th:text="${#numbers.formatDecimal(product.price / 1000, 0, 'COMMA', 3, 'POINT')} + ' đ'">
                0 đ
            </p>

        </div>
    </div>

    <div th:if="${discountedProducts == null or #lists.isEmpty(discountedProducts)}" class="max-w-7xl mx-auto mt-6 px-4 pb-10">
        <p class="text-center text-gray-500 text-lg font-semibold select-none">Không tìm thấy sản phẩm phù hợp.</p>
    </div>

</main>

<div th:replace="/users/layout :: footer"></div>

</body>
</html>