<div th:fragment="categories">
    <nav class="bg-black text-white text-sm w-full px-4 py-2">
        <ul class="flex flex-wrap items-center justify-between font-semibold select-none max-w-full mx-auto">
            <!-- Left: Categories from DB -->
            <li class="flex space-x-6 overflow-x-auto max-w-[50%]">
                <a th:each="category : ${categories}" th:href="@{/managerProduct/category/{id}(id=${category.categoryID})}" class="flex items-center space-x-2 no-underline hover:no-underline whitespace-nowrap">
<!--                    <img th:src="${category.image}" th:alt="'Image of category ' + ${category.categoryName}" class="w-10 h-10 object-cover rounded-full border border-white"/>-->
                    <span th:text="${category.categoryName}" class="text-base">
       Tên danh mục
      </span>
                </a>
            </li>
            <li class="flex items-center flex-shrink-0 mx-4 w-64">
                <form id="search-form" th:action="@{/managerUser/searchProduct}" method="GET" class="flex w-full mb-0" role="search">
                    <input
                            id="search-input"
                            type="search"
                            name="keyword"
                            th:value="${keyword}"
                            placeholder="Tìm kiếm sản phẩm..."
                            class="flex-grow border border-gray-600 rounded-l-md px-3 py-1.5 text-gray-200 placeholder-gray-400 bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition text-sm"
                    />
                    <button
                            type="submit"
                            class="bg-blue-700 hover:bg-blue-800 text-white px-3 rounded-r-md font-semibold transition flex items-center justify-center shadow-md"
                            aria-label="Search"
                    >
                        <i class="fas fa-search text-base"></i>
                    </button>
                </form>
            </li>

            <li class="flex space-x-8 whitespace-nowrap max-w-[30%] justify-end">
