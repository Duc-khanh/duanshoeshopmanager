                            <span>Giỏ hàng</span>
                            <span class="absolute -top-2 -right-3 bg-red-600 text-white rounded-full px-2 text-xs font-bold shadow-lg"
                                  th:if="${session.cartItemCount != null and session.cartItemCount > 0}">
            <span th:text="${session.cartItemCount}"></span>
        </span>
