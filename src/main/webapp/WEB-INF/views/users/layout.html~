                        </a>
                    </li>


                    <li th:if="${session.currentUser == null}">
                        <a href="/login"
                           class="flex items-center text-lg hover:text-blue-600 bg-transparent border-0 cursor-pointer">
                            <i class="fas fa-sign-in-alt mr-2 text-xl"></i>
                            <span>Đăng nhập</span>
                        </a>
                    </li>
