<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title th:replace="${title} ?: 'Trang Chủ'">Trang Chủ</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
        }

        .product-scrollbar::-webkit-scrollbar {
            height: 8px;
        }

        .product-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .product-scrollbar::-webkit-scrollbar-thumb {
            background: #3b82f6;
            border-radius: 10px;
        }

        .product-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #2563eb;
        }
    </style>
</head>
<body class="bg-white text-black min-h-screen flex flex-col">

<!-- Top thin bar -->
<div class="bg-[#e6f0e9] text-[#7cae8f] text-xs text-center py-1 select-none">
    Nhận Order Mẫu giày Hiếm...!
</div>

<!-- Header -->
<div th:fragment="header">
    <header class="border-b border-gray-300 sticky top-0 z-50 bg-white w-full">
        <div class="w-full max-w-full px-4 py-3 flex items-center justify-between mx-auto">
            <!-- Logo -->
            <a href="/" class="flex items-center space-x-2 select-none">
                <img src="https://storage.googleapis.com/a1aa/image/87e3fa51-f86f-465d-a4de-9c2158252302.jpg"
                     alt="1Sneaker logo black background with white text" class="h-10 w-auto" width="120" height="40"/>
                <span class="text-xs font-bold tracking-tight select-none">YOUNG FASHION STYLE</span>
            </a>

            <!-- Search form -->
            <form th:action="@{/managerUser/searchProduct}" method="GET" role="search"
                  class="flex border border-gray-300 rounded overflow-hidden max-w-xl w-full mx-4">
                <input type="search" name="keyword" th:value="${keyword}" placeholder="Tìm kiếm..."
                       class="flex-grow px-3 py-2 text-sm outline-none"/>
                <select aria-label="Category select"
                        class="border-l border-gray-300 text-xs px-2 py-2 outline-none bg-white">
                    <option>Tất cả danh mục</option>
                    <option>Giày Nike</option>
                    <option>Giày MLB</option>
                    <option>Balenciaga</option>
                    <option>Adidas</option>
                    <option>Giày Converse</option>
                    <option>Vans</option>
                    <option>Giày Sneaker</option>
                    <option>Giày Thể Thao</option>
                    <option>Gucci</option>
                </select>
                <button type="submit" aria-label="Search"
                        class="bg-white px-3 flex items-center justify-center border-l border-gray-300 text-gray-600 hover:text-black">
                    <i class="fas fa-search"></i>
                </button>
            </form>

            <nav>
                <ul class="hidden md:flex space-x-10 text-gray-700 font-semibold">
                    <li>
                        <a class="hover:text-blue-600 text-lg" th:href="@{/users}">
                            Xem sản phẩm
                        </a>
                    </li>
                    <li>
                        <a class="hover:text-blue-600 relative flex items-center text-lg" th:href="@{/cart}">
                            <i class="fas fa-shopping-cart mr-2 text-2xl">
                            </i>
                            Giỏ hàng
                            <span class="absolute -top-2 -right-3 bg-red-600 text-white rounded-full px-2 text-xs font-bold shadow-lg"
                                  th:text="${session.cartItemCount != null ? session.cartItemCount : 0}">
         </span>
                        </a>
                    </li>
                    <li>
                        <a class="hover:text-blue-600 text-lg" th:href="@{/logout}">
                            Đăng xuất
                        </a>
                    </li>
                </ul>
                <button aria-label="Toggle mobile menu" class="md:hidden text-gray-700" id="mobile-menu-button">
                    <i class="fas fa-bars fa-lg">
                    </i>
                </button>
            </nav>
        </div>
        <div>
            <nav class="bg-black text-white text-xs w-full px-4">
                <ul class="flex flex-wrap items-center justify-center gap-3 py-2 font-semibold select-none max-w-full mx-auto">
                    <li class="flex items-center space-x-1 cursor-pointer">
