<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Giỏ hàng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono&display=swap" rel="stylesheet"/>
</head>

<body class="bg-gray-50 min-h-screen font-['Montserrat']">
<div class="w-full fixed top-0 left-0 right-0" th:replace="/users/layout :: header"></div>

<main class="mx-auto my-20 w-full max-w-[85%] flex flex-col md:flex-row gap-8 px-4 md:px-8" style="min-width: 320px;">
    <form th:if="${!#lists.isEmpty(cartItems)}" th:action="@{/order}" method="post" class="w-full flex-grow md:flex gap-8">
    <section class="md:w-2/3 bg-white rounded-lg shadow-md overflow-x-auto min-h-[300px] flex flex-col">
        <h2 class="text-3xl font-bold mb-6 text-gray-800 text-center md:text-left p-6 border-b border-gray-200">
            Giỏ hàng của bạn
        </h2>

        <div>
            <table class="min-w-full divide-y divide-gray-200 table-fixed">
                <thead class="bg-gray-100">
                <tr>
                    <th class="w-12 px-4 py-3 text-center align-middle">
                        <input type="checkbox" id="selectAll" onclick="toggleAllCheckboxes(this)" class="cursor-pointer"/>
                    </th>
                    <th class="w-[40%] px-6 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider align-middle">Tên SP</th>
                    <th class="w-24 px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider align-middle">Giá</th>
                    <th class="w-28 px-6 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider whitespace-nowrap align-middle">Số lượng</th>
                    <th class="w-32 px-6 py-3 text-right text-xs font-semibold text-gray-600 uppercase tracking-wider whitespace-nowrap align-middle">Thành tiền</th>
                    <th class="w-28 px-6 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider align-middle whitespace-nowrap">Hành động</th>
                </tr>
                </thead>

                <tbody class="bg-white divide-y divide-gray-200" th:each="item : ${cartItems}">
                <tr class="hover:bg-gray-50 transition">
                    <td class="px-4 py-4 text-center align-middle">
                        <input type="checkbox" class="item-checkbox cursor-pointer" th:name="selectedItems" th:value="${item.product.productID}">
                    </td>
                    <td class="px-6 py-4 whitespace-normal text-gray-900 font-medium align-middle break-words" th:text="${item.product.productName}">Tên sản phẩm</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-gray-700 price-cell align-middle font-mono" th:attr="data-price=${item.product.price}"></td>
                    <td class="px-6 py-4 whitespace-nowrap text-center text-gray-700 align-middle">
                        <input type="number" min="1" th:value="${item.quantity}" onchange="#updateQuantity(this)"
                               th:name="${'quantities[' + item.product.productID + ']'}" th:attr="data-price=${item.product.price}, data-id=${item.product.productID}"
                               class="quantity-input w-20 text-center border border-gray-300 rounded px-2 py-1 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-red-900 font-semibold item-total align-middle font-mono" th:attr="data-id=${item.product.productID}"></td>
                    <td class="px-6 py-4 whitespace-nowrap text-center align-middle">
                        <a th:href="@{/cart/remove/{productId}(productId=${item.product.productID})}" class="inline-flex items-center px-3 py-1 text-sm font-medium text-red-600 hover:text-white hover:bg-red-600 rounded-md border border-red-600 transition whitespace-nowrap">
                            <i class="fas fa-trash-alt mr-1"></i> Xóa
                        </a>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="w-full md:w-[30%] bg-white rounded-lg shadow-md p-6 flex flex-col justify-between">
        <h3 class="text-2xl font-bold mb-6 text-gray-800 border-b border-gray-200 pb-4">Tóm tắt giỏ hàng</h3>
        <div class="flex flex-col gap-4 mb-6">
            <div class="flex justify-between text-gray-700 text-lg">
                <span>Tổng tiền đã mua:</span>
                <span id="summaryTotalAmount" class="font-mono">0₫</span>
            </div>
            <div class="flex justify-between text-gray-700 text-lg">
                <span>Phụ phí:</span>
                <span id="summaryFee" class="font-mono">0₫</span>
            </div>
            <div class="flex justify-between text-xl font-semibold text-gray-900 border-t border-gray-300 pt-4">
                <span>Tổng thanh toán:</span>
                <span id="summaryFinalAmount" class="font-mono">0₫</span>
            </div>
        </div>
        <div>
            <input type="hidden"  id="summarySelectedItems" value=""/>
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg shadow-md transition flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed" id="summaryCheckoutBtn" disabled>
                Mua hàng <i class="fas fa-shopping-cart ml-2"></i>
            </button>
        </div>

    </section>
    </form>
    <div th:if="${#lists.isEmpty(cartItems)}" class="flex flex-col items-center justify-center flex-grow text-center px-6 py-20 text-red-600 select-none">
        <i class="fas fa-shopping-cart text-6xl mb-6 text-red-600"></i>
        <p class="text-xl font-semibold mb-2">Giỏ hàng của bạn đang trống</p>
        <p class="max-w-xs">Bạn chưa thêm sản phẩm nào vào giỏ hàng. Hãy chọn sản phẩm yêu thích và bắt đầu mua sắm!</p>
    </div>
</main>

<div th:replace="/users/layout :: footer"></div>
<script src="/js/logout-handler.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectAllCheckbox = document.getElementById("selectAll");
        const itemCheckboxes = document.querySelectorAll(".item-checkbox");
        const quantityInputs = document.querySelectorAll(".quantity-input");
        const summaryTotalAmountSpan = document.getElementById("summaryTotalAmount");
        const summaryFeeSpan = document.getElementById("summaryFee");
        const summaryFinalAmountSpan = document.getElementById("summaryFinalAmount");
        const summarySelectedItemsInput = document.getElementById("summarySelectedItems");
        const summaryCheckoutBtn = document.getElementById("summaryCheckoutBtn");

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND',
                maximumFractionDigits: 0
            }).format(amount);
        }

        function updateItemTotal(productId, quantity, price) {
            const totalCell = document.querySelector(`.item-total[data-id='${productId}']`);
            const total = quantity * price;
            if (totalCell) {
                totalCell.textContent = formatCurrency(total);
            }
        }

        function updateQuantity(input) {
            const productId = input.dataset.id;
            const quantity = parseInt(input.value) || 1;
            const price = parseInt(input.dataset.price) || 0;
            updateItemTotal(productId, quantity, price);
            updateTotalAmount();
        }

        function updateTotalAmount() {
            let total = 0;
            let selectedIds = [];

            itemCheckboxes.forEach((checkbox, index) => {
                if (checkbox.checked) {
                    const row = checkbox.closest("tr");
                    const productId = checkbox.value;
                    const quantityInput = row.querySelector(".quantity-input");
                    const quantity = parseInt(quantityInput.value) || 1;
                    const price = parseInt(quantityInput.dataset.price) || 0;

                    const itemTotal = quantity * price;
                    total += itemTotal;
                    selectedIds.push(productId);
                }
            });
            summaryTotalAmountSpan.textContent = formatCurrency(total);
            const fee = 0; 
            summaryFeeSpan.textContent = formatCurrency(fee);
            summaryFinalAmountSpan.textContent = formatCurrency(total + fee);

            summarySelectedItemsInput.value = selectedIds.join(",");
            summaryCheckoutBtn.disabled = selectedIds.length === 0;

            document.querySelectorAll(".price-cell").forEach(cell => {
                const price = parseInt(cell.dataset.price) || 0;
                cell.textContent = formatCurrency(price);
            });
        }

        selectAllCheckbox?.addEventListener("change", function () {
            itemCheckboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
            updateTotalAmount();
        });

        itemCheckboxes.forEach(cb => {
            cb.addEventListener("change", function () {
                const allChecked = Array.from(itemCheckboxes).every(cb => cb.checked);
                if (selectAllCheckbox) selectAllCheckbox.checked = allChecked;
                updateTotalAmount();
            });
        });

        quantityInputs.forEach(input => {
            const quantity = parseInt(input.value) || 1;
            const price = parseInt(input.dataset.price) || 0;
            const productId = input.dataset.id;
            updateItemTotal(productId, quantity, price);

            input.addEventListener("input", () => {
                let val = parseInt(input.value);
                if (isNaN(val) || val < 1) {
                    input.value = 1;
                    val = 1;
                }
                updateItemTotal(productId, val, price);
                updateTotalAmount();
            });
        });

        updateTotalAmount();
    });
</script>
</body>
</html>