<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <title>Cửa Hàng Giày - Trang Người Dùng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-50">
<header class="bg-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center space-x-6 flex-wrap md:flex-nowrap">
        <a class="text-3xl font-extrabold text-blue-700 tracking-wide flex-shrink-0"  th:href="@{/}">
            Cửa Hàng Giày
        </a>

        <form th:action="@{/managerUser/searchProduct}" method="GET" class="flex flex-grow max-w-lg mx-auto"
              role="search" aria-label="Tìm kiếm sản phẩm">
            <input
                    type="search"
                    name="keyword"
                    th:value="${keyword}"
                    placeholder="Tìm kiếm sản phẩm..."
                    aria-label="Tìm kiếm sản phẩm"
                    class="flex-grow border border-gray-300 rounded-l-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <button
                    type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-5 rounded-r-md font-semibold transition"
                    aria-label="Tìm kiếm"
            >
                <i class="fas fa-search"></i>
            </button>
        </form>

        <nav class="flex-shrink-0">
            <ul class="hidden md:flex space-x-8 text-gray-700 font-semibold">
                <li>
                    <a class="hover:text-blue-600 transition" th:href="@{/users}">
                        Xem sản phẩm
                    </a>
                </li>
                <li>
                    <a class="hover:text-blue-600 transition flex items-center" th:href="@{/cart}">
                        <i class="fas fa-shopping-cart mr-1"></i>
                        Giỏ hàng
                    </a>
                </li>
                <li>
                    <a class="hover:text-blue-600 transition" th:href="@{/logout}">
                        Đăng xuất
                    </a>
                </li>
            </ul>
            <button class="md:hidden text-gray-700 focus:outline-none" id="mobile-menu-button" aria-label="Mở menu">
                <i class="fas fa-bars fa-lg"></i>
            </button>
        </nav>
    </div>
    <div class="hidden md:hidden bg-white border-t border-gray-200" id="mobile-menu">
        <ul class="flex flex-col px-6 py-4 space-y-3 text-gray-700 font-semibold">
            <li>
                <a class="block hover:text-blue-600 transition" th:href="@{/users}">
                    Xem sản phẩm
                </a>
            </li>
            <li>
                <a class="block hover:text-blue-600 transition flex items-center" th:href="@{/cart}">
                    <i class="fas fa-shopping-cart mr-1"></i>
                    Giỏ hàng
                </a>
            </li>
            <li>
                <a class="block hover:text-blue-600 transition" th:href="@{/logout}">
                    Đăng xuất
                </a>
            </li>
        </ul>
        <form action="#" method="GET" class="px-6 py-4 border-t border-gray-200" role="search"
              aria-label="Tìm kiếm sản phẩm">
            <div class="flex">
                <input
                        type="search"
                        name="q"
                        placeholder="Tìm kiếm sản phẩm..."
                        aria-label="Tìm kiếm sản phẩm"
                        class="flex-grow border border-gray-300 rounded-l-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                />
                <button
                        type="submit"
                        class="bg-blue-600 hover:bg-blue-700 text-white px-4 rounded-r-md font-semibold transition"
                        aria-label="Tìm kiếm"
                >
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
    </div>
    <div align="center" th:if="${#lists.isEmpty(productList)}" class="py-6 text-gray-700 font-semibold text-lg">
        <p>Không tìm thấy sản phẩm phù hợp.</p>
    </div>
</header>

<main class="max-w-7xl mx-auto px-6 py-10">
    <h2 class="text-4xl font-extrabold text-gray-900 mb-10 text-center">
        Sản Phẩm Nổi Bật
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        <div th:each="product : ${productList}" th:if="${product.stock > 0}"
             class="bg-white rounded-2xl shadow-lg flex flex-col hover:shadow-2xl transition-shadow duration-300 h-full min-h-[520px]">

            <img th:src="${product.image}" th:alt="'Ảnh sản phẩm ' + ${product.productName}"
                 class="rounded-t-2xl object-contain h-56 w-full bg-gray-100 p-6"/>

            <div class="p-6 flex flex-col flex-grow">
                <div class="mb-3">
                    <span class="block text-xs text-gray-500 mt-1">Tên sản phẩm</span>
                    <h3 class="text-lg font-semibold text-gray-900 truncate" th:text="${product.productName}">
                        Giày Thể Thao Nam Trắng
                    </h3>

                </div>
                <span class="block text-xs text-gray-500 mt-1">Mô tả</span>

                <p class="text-gray-600 text-sm flex-grow mb-4 line-clamp-3" th:text="${product.description}">
                    Mô tả sản phẩm chi tiết, hấp dẫn và đầy đủ thông tin để khách hàng dễ dàng lựa chọn.
                </p>

                <div class="mb-5 space-y-2 text-gray-900 font-semibold text-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-700">Số lượng</span>
                        <span class="text-gray-700" th:text="${product.stock}">0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-700">Giá</span>
                        <span class="text-green-600 text-base font-bold"
                              th:text="${#numbers.formatDecimal(product.price, 0, 'COMMA', 3, 'POINT')} + ' đ'">
                            ₫1,200,000
                        </span>
                    </div>
                </div>

                <div class="flex justify-center gap-8 mt-auto">
                    <a class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg font-semibold transition flex items-center justify-center shadow-md"
                       title="Thêm vào giỏ hàng" aria-label="Thêm sản phẩm vào giỏ hàng"
                       th:href="@{/cart/add/{productID}(productID=${product.productID})}">
                        <i class="fas fa-shopping-cart text-lg"></i>
                    </a>

                    <a class="bg-gray-200 hover:bg-gray-300 text-gray-700 p-3 rounded-lg font-semibold transition flex items-center justify-center shadow-md"
                       title="Xem chi tiết sản phẩm" aria-label="Xem chi tiết sản phẩm"
                       th:href="@{/managerUser/view/{productID}(productID = ${product.productID})}">
                        <i class="fas fa-eye text-lg"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<section class="bg-white mt-20 py-14">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-8 text-center">
            Tại Sao Chọn Chúng Tôi?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
            <div>
                <i class="fas fa-shipping-fast text-blue-600 text-6xl mb-5"></i>
                <h3 class="text-2xl font-semibold mb-3">Giao Hàng Nhanh</h3>
                <p class="text-gray-600 max-w-xs mx-auto">Giao hàng nhanh chóng trong vòng 24 giờ trên toàn quốc.</p>
            </div>
            <div>
                <i class="fas fa-shield-alt text-blue-600 text-6xl mb-5"></i>
                <h3 class="text-2xl font-semibold mb-3">Chất Lượng Đảm Bảo</h3>
                <p class="text-gray-600 max-w-xs mx-auto">Sản phẩm chính hãng, bảo hành và đổi trả dễ dàng.</p>
            </div>
            <div>
                <i class="fas fa-headset text-blue-600 text-6xl mb-5"></i>
                <h3 class="text-2xl font-semibold mb-3">Hỗ Trợ 24/7</h3>
                <p class="text-gray-600 max-w-xs mx-auto">Đội ngũ chăm sóc khách hàng luôn sẵn sàng hỗ trợ bạn.</p>
            </div>
        </div>
    </div>
</section>

<footer class="bg-blue-900 text-gray-300 mt-20">
    <div class="max-w-7xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
            <h4 class="text-white font-bold text-xl mb-5">Cửa Hàng Giày</h4>
            <p class="mb-2">Địa chỉ: 123 Đường Hồ Tùng Mậu, Quận Nam Từ Liêm, TP. Hà Nội</p>
            <p class="mb-2">Điện thoại: 0856 123 456</p>
            <p>Email: Duckhanh@gmail.vn</p>
        </div>
        <div>
            <h4 class="text-white font-bold text-xl mb-5">Liên Kết</h4>
            <ul class="space-y-3">
                <li>
                    <a class="hover:text-white transition text-lg" th:href="@{/users}">Xem sản phẩm</a>
                </li>
                <li>
                    <a class="hover:text-white transition text-lg" th:href="@{/cart}">Giỏ hàng</a>
                </li>
                <li>
                    <a class="hover:text-white transition text-lg" th:href="@{/logout}">Đăng xuất</a>
                </li>
            </ul>
        </div>
        <div>
            <h4 class="text-white font-bold text-xl mb-5">Theo Dõi Chúng Tôi</h4>
            <div class="flex space-x-8 text-3xl">
                <a aria-label="Facebook" class="hover:text-white transition" href="#">
                    <i class="fab fa-facebook-square"></i>
                </a>
                <a aria-label="Instagram" class="hover:text-white transition" href="#">
                    <i class="fab fa-instagram"></i>
                </a>
                <a aria-label="Twitter" class="hover:text-white transition" href="#">
                    <i class="fab fa-twitter-square"></i>
                </a>
                <a aria-label="YouTube" class="hover:text-white transition" href="#">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="border-t border-blue-800 mt-10 py-5 text-center text-sm text-blue-300">
        © 2023 Cửa Hàng Giày. Tất cả quyền được bảo lưu.
    </div>
</footer>

<script>
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
    });
</script>
</body>
</html>