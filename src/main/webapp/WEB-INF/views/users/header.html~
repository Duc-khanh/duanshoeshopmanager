<!-- fragments/header.html -->
<div th:fragment="/users/header">
  <header class="bg-white shadow-lg sticky top-0 z-50">
    <div class="max-w-[90rem] mx-auto px-4 py-5 flex justify-between items-center flex-wrap md:flex-nowrap">
      <a class="text-3xl font-extrabold text-blue-700 hover:text-blue-800 transition"
         th:href="@{/}">Cửa Hàng Giày</a>

      <!-- Form tìm kiếm -->
      <form th:action="@{/managerUser/searchProduct}" method="GET"
            class="flex flex-grow max-w-2xl mx-auto my-3 md:my-0" role="search">
        <input type="search" name="keyword" th:value="${keyword}"
               placeholder="Tìm kiếm sản phẩm..."
               class="flex-grow border border-gray-300 rounded-l-lg px-5 py-3"/>
        <button type="submit"
                class="bg-blue-600 hover:bg-blue-700 text-white px-6 rounded-r-lg font-semibold transition">
          <i class="fas fa-search text-lg"></i>
        </button>
      </form>

      <!-- Menu -->
      <nav>
        <ul class="hidden md:flex space-x-10 text-gray-700 font-semibold">
          <li><a th:href="@{/users}" class="hover:text-blue-600 text-lg">Xem sản phẩm</a></li>
          <li>
            <a th:href="@{/cart}" class="hover:text-blue-600 relative flex items-center text-lg">
              <i class="fas fa-shopping-cart mr-2 text-2xl"></i> Giỏ hàng
              <span th:text="${session.cartItemCount != null ? session.cartItemCount : 0}"
                    class="absolute -top-2 -right-3 bg-red-600 text-white rounded-full px-2 text-xs font-bold shadow-lg"></span>
            </a>
          </li>
          <li><a th:href="@{/logout}" class="hover:text-blue-600 text-lg">Đăng xuất</a></li>
        </ul>
        <button class="md:hidden text-gray-700" id="mobile-menu-button">
          <i class="fas fa-bars fa-lg"></i>
        </button>
      </nav>
    </div>
    <!-- Mobile menu -->
    <div class="hidden md:hidden bg-white border-t border-gray-200" id="mobile-menu">
      <ul class="flex flex-col px-6 py-4 space-y-4 text-gray-700 font-semibold">
        <li><a class="block hover:text-blue-600 text-lg" th:href="@{/users}">Xem sản phẩm</a></li>
        <li><a class="block hover:text-blue-600 flex items-center text-lg" th:href="@{/cart}">
          <i class="fas fa-shopping-cart mr-2 text-2xl"></i>Giỏ hàng</a></li>
        <li><a class="block hover:text-blue-600 text-lg" th:href="@{/logout}">Đăng xuất</a></li>
      </ul>
    </div>
  </header>
</div>
