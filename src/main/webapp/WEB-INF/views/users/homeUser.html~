<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1" name="viewport"/>
    <title>Cửa Hàng Giày - Trang Người Dùng</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-gray-50">
<header class="bg-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center space-x-6 flex-wrap md:flex-nowrap">
        <a class="text-3xl font-extrabold text-blue-700 tracking-wide flex-shrink-0" href="#" th:href="@{/}">
            Cửa Hàng Giày
        </a>

        <form th:action="@{/managerUser/searchProduct}" method="GET" class="flex flex-grow max-w-lg mx-auto"
              role="search" aria-label="Tìm kiếm sản phẩm">
            <input
                    type="search"
                    name="keyword"
                    th:value="${keyword}"
                    placeholder="Tìm kiếm sản phẩm..."
                    aria-label="Tìm kiếm sản phẩm"
                    class="flex-grow border border-gray-300 rounded-l-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <button
                    type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-5 rounded-r-md font-semibold transition"
                    aria-label="Tìm kiếm"
            >
                <i class="fas fa-search"></i>
            </button>
        </form>

        <nav class="flex-shrink-0">
            <ul class="hidden md:flex space-x-8 text-gray-700 font-semibold">
                <li>
                    <a class="hover:text-blue-600 transition" th:href="@{/products}">
                        Xem sản phẩm
                    </a>
                </li>
                <li>
                    <a class="hover:text-blue-600 transition flex items-center" th:href="@{/cart}">
                        <i class="fas fa-shopping-cart mr-1"></i>
                        Giỏ hàng
                    </a>
                </li>
                <li>
                    <a class="hover:text-blue-600 transition" th:href="@{/logout}">
                        Đăng xuất
                    </a>
                </li>
            </ul>
            <button class="md:hidden text-gray-700 focus:outline-none" id="mobile-menu-button" aria-label="Mở menu">
                <i class="fas fa-bars fa-lg"></i>
            </button>
        </nav>
    </div>
    <div class="hidden md:hidden bg-white border-t border-gray-200" id="mobile-menu">
        <ul class="flex flex-col px-6 py-4 space-y-3 text-gray-700 font-semibold">
            <li>
                <a class="block hover:text-blue-600 transition" th:href="@{/cart/view}">
                    Xem sản phẩm
                </a>
            </li>
            <li>
                <a class="block hover:text-blue-600 transition flex items-center" th:href="@{/cart/view}">
                    <i class="fas fa-shopping-cart mr-1"></i>
                    Giỏ hàng
                </a>
            </li>
            <li>
                <a class="block hover:text-blue-600 transition" th:href="@{/logout}">
                    Đăng xuất
                </a>
            </li>
        </ul>
        <form action="#" method="GET" class="px-6 py-4 border-t border-gray-200" role="search"
              aria-label="Tìm kiếm sản phẩm">
            <div class="flex">
                <input
                        type="search"
                        name="q"
                        placeholder="Tìm kiếm sản phẩm..."
                        aria-label="Tìm kiếm sản phẩm"
                        class="flex-grow border border-gray-300 rounded-l-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                />
                <button
                        type="submit"
                        class="bg-blue-600 hover:bg-blue-700 text-white px-4 rounded-r-md font-semibold transition"
                        aria-label="Tìm kiếm"
                >
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </form>
    </div>
    <div align="center" th:if="${#lists.isEmpty(productList)}">
        <p>Không tìm thấy sản phẩm phù hợp.</p>
    </div>
</header>

<main class="max-w-7xl mx-auto px-6 py-10">
    <h2 class="text-4xl font-extrabold text-gray-900 mb-8 text-center">
        Sản Phẩm Nổi Bật
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        <div th:each="product : ${productList}" th:if="${product.stock > 0}"
             class="bg-white rounded-xl shadow-lg flex flex-col hover:shadow-2xl transition-shadow duration-300 h-full min-h-[460px]">

            <img th:src="${product.image}" th:alt="'Ảnh sản phẩm ' + ${product.productName}"
                 class="rounded-t-xl object-contain h-48 w-full"/>

            <div class="p-4 flex flex-col flex-grow">
                <div class="grid grid-cols-[auto_1fr] gap-x-2 items-center mb-1">
                    <label class="text-gray-900 font-semibold text-sm whitespace-nowrap">Tên sản phẩm:</label>
                    <span class="text-lg font-semibold text-gray-900" th:text="${product.productName}">
                        Giày Thể Thao Nam Trắng
                    </span>
                </div>

                <div class="grid grid-cols-[auto_1fr] gap-x-2 items-start mb-2">
                    <label class="text-gray-900 font-semibold text-sm whitespace-nowrap">Mô tả:</label>
                    <span class="text-gray-600 text-sm" th:text="${product.description}">
                        Mô tả sản phẩm
                    </span>
                </div>

                <div class="grid grid-cols-[auto_1fr] gap-x-2 items-center mb-3">
                    <label class="text-gray-900 font-semibold text-sm whitespace-nowrap">Giá:</label>
                    <span class="text-green-600 font-bold text-base"
                          th:text="${#numbers.formatDecimal(product.price, 0, 'COMMA', 3, 'POINT')} + ' đ'">
                        ₫1,200,000
                    </span>
                </div>

                <div class="grid grid-cols-[auto_1fr] gap-x-2 items-center mb-3">
                    <label class="text-gray-900 font-semibold text-sm whitespace-nowrap">Số lượng:</label>
                    <span class="text-gray-700 text-base" th:text="${product.stock}">
                        0
                    </span>
                </div>

                <div class="flex justify-center gap-6 mt-auto">
                    <a class="bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-md font-semibold transition flex items-center justify-center"
                       title="Thêm vào giỏ hàng" aria-label="Thêm sản phẩm vào giỏ hàng"
                       th:href="@{/cart/add/{productID}(productID=${product.productID})}">
                        <i class="fas fa-shopping-cart"></i>
                    </a>

                    <a class="bg-gray-200 hover:bg-gray-300 text-gray-700 p-2 rounded-md font-semibold transition flex items-center justify-center"
                       title="Xem chi tiết sản phẩm" aria-label="Xem chi tiết sản phẩm"
                       th:href="@{/managerUser/view/{productID}(productID = ${product.productID})}">
                        <i class="fas fa-eye"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</main>

<section class="bg-white mt-16 py-12">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-6 text-center">
            Tại Sao Chọn Chúng Tôi?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 text-center">
            <div>
                <i class="fas fa-shipping-fast text-blue-600 text-5xl mb-4"></i>
                <h3 class="text-xl font-semibold mb-2">Giao Hàng Nhanh</h3>
                <p class="text-gray-600">Giao hàng nhanh chóng trong vòng 24 giờ trên toàn quốc.</p>
            </div>
            <div>
                <i class="fas fa-shield-alt text-blue-600 text-5xl mb-4"></i>
                <h3 class="text-xl font-semibold mb-2">Chất Lượng Đảm Bảo</h3>
                <p class="text-gray-600">Sản phẩm chính hãng, bảo hành và đổi trả dễ dàng.</p>
            </div>
            <div>
                <i class="fas fa-headset text-blue-600 text-5xl mb-4"></i>
                <h3 class="text-xl font-semibold mb-2">Hỗ Trợ 24/7</h3>
                <p class="text-gray-600">Đội ngũ chăm sóc khách hàng luôn sẵn sàng hỗ trợ bạn.</p>
            </div>
        </div>
    </div>
</section>

<footer class="bg-blue-900 text-gray-300 mt-16">
    <div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
            <h4 class="text-white font-bold text-lg mb-4">Cửa Hàng Giày</h4>
            <p>Địa chỉ: 123 Đường Hồ Tùng Mậu, Quận Nam Từ Liêm, TP. Hà Nội</p>
            <p>Điện thoại: 0856 123 456</p>
            <p>Email: Duckhanh@gmail.vn</p>
        </div>
        <div>
            <h4 class="text-white font-bold text-lg mb-4">Liên Kết</h4>
            <ul class="space-y-2">
                <li>
                    <a class="hover:text-white transition" th:href="@{/products}">Xem sản phẩm</a>
                </li>
                <li>
                    <a class="hover:text-white transition" th:href="@{/cart}">Giỏ hàng</a>
                </li>
                <li>
                    <a class="hover:text-white transition" th:href="@{/logout}">Đăng xuất</a>
                </li>
            </ul>
        </div>
        <div>
            <h4 class="text-white font-bold text-lg mb-4">Theo Dõi Chúng Tôi</h4>
            <div class="flex space-x-6 text-2xl">
                <a aria-label="Facebook" class="hover:text-white transition" href="#">
                    <i class="fab fa-facebook-square"></i>
                </a>
                <a aria-label="Instagram" class="hover:text-white transition" href="#">
                    <i class="fab fa-instagram"></i>
                </a>
                <a aria-label="Twitter" class="hover:text-white transition" href="#">
                    <i class="fab fa-twitter-square"></i>
                </a>
                <a aria-label="YouTube" class="hover:text-white transition" href="#">
                    <i class="fab fa-youtube"></i>
                </a>
            </div>
        </div>
    </div>
    <div class="border-t border-blue-800 mt-8 py-4 text-center text-sm text-blue-300">
        © 2023 Cửa Hàng Giày. Tất cả quyền được bảo lưu.
    </div>
</footer>

<script>
    document.getElementById('mobile-menu-button').addEventListener('click', function () {
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('hidden');
    });

    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
    });
</script>
</body>
</html>